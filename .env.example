# Образец окружения. Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Сам .env в репозиторий не попадает (он в .gitignore) — здесь только ключи,
# без значений. Переменные, заданные в окружении, сильнее этого файла: так
# настраивают контейнеры и CI, где .env нет вовсе.
#
# Настроек студии здесь НЕТ намеренно. Часы работы, шаг сетки слотов, окно
# отмены, лимит переносов, горизонт записи, порог автоблокировки — всё это
# лежит в таблице salon_settings, потому что их меняет администратор студии
# через интерфейс, а не системный администратор правкой файла с перезапуском.

# Порт HTTP-сервера. По умолчанию 3001.
PORT=

# Файл базы SQLite. По умолчанию api/db/lada.sqlite.
LADA_DB_PATH=

# Срок жизни сессии в днях. По умолчанию 30.
SESSION_TTL_DAYS=

# Ограничение частоты входа и регистрации: сколько попыток с одного адреса
# за сколько минут. По умолчанию 10 попыток за 15 минут.
AUTH_RATE_WINDOW_MIN=
AUTH_RATE_MAX_ATTEMPTS=

# Режим запуска. Сид заводит владельца и администратора студии, поэтому
# без NODE_ENV=development он откажется работать: так случайный
# `npm run seed` на стенде не создаст посторонним вход. Обойти осознанно:
# `npm run seed -- --allow-non-dev`.
NODE_ENV=

# Пароль демонстрационных аккаунтов, которые заводит `npm run seed`.
# Умолчания НЕТ — ни для разработки, ни для продакшена: пока оно было,
# пароль владельца студии знал любой, кто видел репозиторий. Придумайте
# своё значение; оно останется в вашем .env и никуда не уедет.
SEED_PASSWORD=
